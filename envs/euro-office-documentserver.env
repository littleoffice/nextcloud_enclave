NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
DB_TYPE=postgres
DB_HOST=euro-office-postgres
DB_PORT=5432
DB_PWD=EUROOFFICE_POSTGRES_SECRET
DB_NAME=eurooffice
DB_USER=eurooffice
AMQP_URI=amqp://eurooffice:EUROOFFICE_RABBITMQ_SECRET@euro-office-rabbitmq
JWT_ENABLED=true
JWT_SECRET=EUROOFFICE_JWT_SECRET
JWT_HEADER=Authorization
JWT_IN_BODY=true